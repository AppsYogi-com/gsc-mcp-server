{
    "name": "@appsyogi/gsc-mcp-server",
    "version": "0.2.3",
    "description": "Google Search Console MCP Server - CLI-installable MCP server for GSC integration",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "gsc-mcp": "./dist/cli/index.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "start": "node dist/cli/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test",
        "test": "vitest run",
        "test:smoke": "vitest run --config vitest.smoke.config.ts",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "mcp",
        "google-search-console",
        "gsc",
        "seo",
        "model-context-protocol",
        "claude",
        "cursor",
        "ai",
        "search-analytics"
    ],
    "author": "SuperZero11",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AppsYogi-com/gsc-mcp-server.git"
    },
    "bugs": {
        "url": "https://github.com/AppsYogi-com/gsc-mcp-server/issues"
    },
    "homepage": "https://github.com/AppsYogi-com/gsc-mcp-server#readme",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.25.0",
        "better-sqlite3": "^11.0.0",
        "chalk": "^5.3.0",
        "commander": "^12.0.0",
        "env-paths": "^3.0.0",
        "google-auth-library": "^10.9.1",
        "googleapis": "^176.0.0",
        "googleapis-common": "8.0.1",
        "keytar": "^7.9.0",
        "open": "^10.0.0",
        "ora": "^8.0.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/better-sqlite3": "^7.6.0",
        "@types/node": "^22.0.0",
        "eslint": "^9.39.5",
        "tsup": "^8.0.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.72.2",
        "vitest": "^4.1.12"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.1"
        }
    }
}
